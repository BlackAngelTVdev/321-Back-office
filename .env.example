# Copier ce fichier en « .env » et adapter les valeurs.
# Les variables déjà définies dans l'environnement restent prioritaires.

# Broker MQTT (ou BACKOFFICE_MQTT_URL=mqtt://hote:1883)
BACKOFFICE_MQTT_HOST=mqqt.blue.section-inf.ch
BACKOFFICE_MQTT_PORT=1883
BACKOFFICE_MQTT_USERNAME=ict
BACKOFFICE_MQTT_PASSWORD=

# Topic d'heure : { "UnixTimeStamp": 1794218169 }
BACKOFFICE_MQTT_TIME_TOPIC=umddcmid3b/dg/time

# Topic de publication du business
BACKOFFICE_MQTT_TOPIC=umddcmid3b/business
