<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="BackOffice.Ui.MainWindow"
        Title="321 Back Office"
        Width="1180"
        Height="780"
        MinWidth="980"
        MinHeight="640"
        Background="#0F1218">

  <DockPanel LastChildFill="True">

    <!-- Barre d'actions -->
    <Border DockPanel.Dock="Top"
            Background="#141821"
            BorderBrush="#232A36"
            BorderThickness="0,0,0,1"
            Padding="12,8">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Button x:Name="OpenButton" Content="Ouvrir un business…" />
        <Button x:Name="MineButton" Content="Mes données" />
        <Button x:Name="SaveButton" Content="Enregistrer (Ctrl+S)" />
        <Button x:Name="ExportButton" Content="Exporter en un fichier…" />
        <Button x:Name="PublishButton" Content="Publier (MQTT)" />
      </StackPanel>
    </Border>

    <!-- Barre d'état -->
    <Border DockPanel.Dock="Bottom"
            Background="#141821"
            BorderBrush="#232A36"
            BorderThickness="0,1,0,0"
            Padding="12,6">
      <TextBlock x:Name="StatusLabel"
                 Text="Prêt."
                 Foreground="#8B95A5"
                 TextTrimming="CharacterEllipsis" />
    </Border>

    <Grid ColumnDefinitions="400,16,*" Margin="16">

      <!-- Fiche du commerce -->
      <Border Grid.Column="0"
              Background="#141821"
              BorderBrush="#232A36"
              BorderThickness="1"
              CornerRadius="12"
              Padding="20">
        <StackPanel Spacing="12">

          <Border Height="200" CornerRadius="8" Background="#1B212B" ClipToBounds="True">
            <Image x:Name="LogoImage" Stretch="UniformToFill" />
          </Border>

          <TextBlock x:Name="NameLabel"
                     Text="—"
                     FontSize="24"
                     FontWeight="Bold"
                     TextWrapping="Wrap" />

          <TextBlock x:Name="IdLabel" Text="—" Foreground="#8B95A5" />

          <Border BorderBrush="#232A36" BorderThickness="1" CornerRadius="8" Padding="12">
            <StackPanel Spacing="10">
              <TextBlock Text="Produit phare" Foreground="#8B95A5" />
              <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Width="88" Height="88" CornerRadius="8" Background="#1B212B" ClipToBounds="True">
                  <Image x:Name="SpecialImage" Stretch="UniformToFill" />
                </Border>
                <StackPanel Width="220" Spacing="4" VerticalAlignment="Center">
                  <TextBlock x:Name="SpecialName" Text="—" FontWeight="SemiBold" TextWrapping="Wrap" />
                  <TextBlock x:Name="SpecialPrice" Text="—" Foreground="#8B95A5" />
                </StackPanel>
              </StackPanel>
            </StackPanel>
          </Border>

        </StackPanel>
      </Border>

      <!-- Édition -->
      <Grid Grid.Column="2" RowDefinitions="Auto,*" RowSpacing="12">

        <Border Grid.Row="0"
                Background="#141821"
                BorderBrush="#232A36"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
          <StackPanel Spacing="10">
            <TextBlock Text="Fiche du commerce" FontWeight="SemiBold" />
            <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="8">

              <TextBlock Grid.Row="0" Grid.Column="0" Text="ID (COM-XXXX)"
                         Foreground="#8B95A5" VerticalAlignment="Center" />
              <TextBox x:Name="IdBox" Grid.Row="0" Grid.Column="1" Watermark="COM-0001" />

              <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom"
                         Foreground="#8B95A5" VerticalAlignment="Center" />
              <TextBox x:Name="NameBox" Grid.Row="1" Grid.Column="1" />

              <TextBlock Grid.Row="2" Grid.Column="0" Text="Logo 16:9"
                         Foreground="#8B95A5" VerticalAlignment="Center" />
              <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox x:Name="LogoBox" Grid.Column="0" Watermark="assets/logo.png" />
                <Button x:Name="BrowseLogoButton" Grid.Column="1" Content="Parcourir…" />
              </Grid>

              <TextBlock Grid.Row="3" Grid.Column="0" Text="Heure (HH:mm)"
                         Foreground="#8B95A5" VerticalAlignment="Center" />
              <Grid Grid.Row="3" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                <TextBox x:Name="TimeBox" Grid.Column="0" Watermark="09:30" />
                <Button x:Name="NowButton" Grid.Column="1" Content="Heure du PC" />
              </Grid>

              <TextBlock Grid.Row="4" Grid.Column="0" Text="Produit phare"
                         Foreground="#8B95A5" VerticalAlignment="Center" />
              <ComboBox x:Name="SpecialCombo" Grid.Row="4" Grid.Column="1"
                        HorizontalAlignment="Stretch" />

            </Grid>
          </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Background="#141821"
                BorderBrush="#232A36"
                BorderThickness="1"
                CornerRadius="12"
                Padding="16">
          <Grid RowDefinitions="Auto,*,Auto" RowSpacing="10">

            <TextBlock Grid.Row="0" Text="Produits" FontWeight="SemiBold" />

            <ListBox x:Name="ProductList" Grid.Row="1" Background="#10151E" MinHeight="140">
              <ListBox.ItemTemplate>
                <DataTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="10">
                    <Image Source="{Binding Icon}" Width="48" Height="48" Stretch="UniformToFill" />
                    <TextBlock Text="{Binding Label}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" />
                  </StackPanel>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>

            <Border Grid.Row="2" BorderBrush="#232A36" BorderThickness="1" CornerRadius="8" Padding="12">
              <StackPanel Spacing="10">
                <TextBlock Text="Fiche produit" FontWeight="SemiBold" />
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto"
                      RowSpacing="8" ColumnSpacing="8">

                  <TextBlock Grid.Row="0" Grid.Column="0" Text="ID (PROD-XXXX)"
                             Foreground="#8B95A5" VerticalAlignment="Center" />
                  <TextBox x:Name="ProductIdBox" Grid.Row="0" Grid.Column="1" Watermark="PROD-0001" />

                  <TextBlock Grid.Row="1" Grid.Column="0" Text="Nom"
                             Foreground="#8B95A5" VerticalAlignment="Center" />
                  <TextBox x:Name="ProductNameBox" Grid.Row="1" Grid.Column="1" />

                  <TextBlock Grid.Row="2" Grid.Column="0" Text="Image carrée"
                             Foreground="#8B95A5" VerticalAlignment="Center" />
                  <Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                    <TextBox x:Name="ProductPictureBox" Grid.Column="0" Watermark="assets/produit.png" />
                    <Button x:Name="BrowsePictureButton" Grid.Column="1" Content="Parcourir…" />
                  </Grid>

                  <TextBlock Grid.Row="3" Grid.Column="0" Text="Prix unitaire"
                             Foreground="#8B95A5" VerticalAlignment="Center" />
                  <StackPanel Grid.Row="3" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <NumericUpDown x:Name="PriceBox"
                                   Width="150"
                                   Minimum="0"
                                   Maximum="100000"
                                   Increment="0.5"
                                   FormatString="0.00" />
                    <TextBlock Text="CHF" Foreground="#8B95A5" VerticalAlignment="Center" />
                  </StackPanel>

                  <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Button x:Name="AddButton" Content="Ajouter" />
                    <Button x:Name="UpdateButton" Content="Mettre à jour" />
                    <Button x:Name="RemoveButton" Content="Supprimer" />
                  </StackPanel>

                </Grid>
              </StackPanel>
            </Border>

          </Grid>
        </Border>

      </Grid>
    </Grid>
  </DockPanel>
</Window>
